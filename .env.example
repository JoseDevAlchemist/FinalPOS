# ---------------------------------------------------------------------------
# Pedigree POS 2.0 — environment variables
#
# Copy this file to `.env.local` and fill it in. `.env*` is gitignored, so real
# values are never committed. Only `NEXT_PUBLIC_*` variables reach the browser
# bundle.
#
# The POS shares the storefront's Supabase project. Use the same project URL and
# publishable key as the Pedigree Leather website, subject to the compatibility
# review in database-contract.md.
# ---------------------------------------------------------------------------

# Dashboard -> Project Settings -> Data API.
NEXT_PUBLIC_SUPABASE_URL=

# Dashboard -> Project Settings -> API Keys. Safe in the browser ONLY because
# RLS is correct. Never put a service-role/secret key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the PIN login route handler to read staff records and
# mint a Supabase Auth session for the linked staff account. This bypasses RLS;
# it must never reach the browser bundle, a log or a client error message.
# Dashboard -> Project Settings -> API Keys -> service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# M-Pesa / Daraja STK Push — server-side only (Phase 7)
# ---------------------------------------------------------------------------
# Never expose these to the browser and never commit real values.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
# Optional: C2B registration shortcode from Daraja if different from STK.
MPESA_C2B_SHORTCODE=

# Safaricom cannot reach localhost; development requires a public tunnel.
MPESA_CALLBACK_URL=

# Server-only random secret (at least 32 characters) authenticates callback URLs.
# Configure upstream proxy/access logs to redact callback query strings too.
MPESA_CALLBACK_SECRET=

# Digital document email (existing Resend integration). Server-only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Public HTTPS app origin for email document links/images in production.
POS_PUBLIC_URL=

# Flutterwave Inline (card only). Only the public key reaches the browser.
NEXT_PUBLIC_FLW_PUBLIC_KEY=
# Server-only verification key. Never use a NEXT_PUBLIC_ prefix for this secret.
FLW_SECRET_KEY=
